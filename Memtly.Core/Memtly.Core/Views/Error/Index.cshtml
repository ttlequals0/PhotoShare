@model IndexModel
@using Memtly.Core.Helpers
@using Memtly.Core.Views.Error

@{
    var reasonCode = 400;
    if (Context.Request.Query.TryGetValue("Reason", out var rawReason) && int.TryParse(rawReason.ToString(), out var parsedReason))
    {
        reasonCode = parsedReason;
    }
    
    var title = _localizer[$"{reasonCode}_Error_Title"].Value;
    var message = _localizer[$"{reasonCode}_Error_Message"].Value;
}

<!--( Error Message )-->
<div class="content border border-primary-1 rounded m-3 m-lg-5 px-1 py-5">
    <p class="text-primary-1 text-center mb-2 error-title">@title</p>
    <p class="text-primary-1 text-center error-detail">@message</p>
</div>